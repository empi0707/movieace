# TMDB API
VITE_API_BASE_URL=https://api.themoviedb.org/
VITE_API_URL=https://api.themoviedb.org/3
VITE_API_VERSION=3
VITE_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
VITE_API_KEY=
VITE_API_ACCESS_TOKEN=

# Default branding. These values can be overridden per iframe session with
# the brand, logo and color URL parameters.
VITE_BRAND=Brand
VITE_PRIMARY_COLOR="#ff5902"

# Canonical production URL used by sitemap.xml and robots.txt.
VITE_SITE_URL=https://cataz.cc

# Number of TMDB result pages per content type included in sitemap.xml (1-100).
SITEMAP_TMDB_PAGES=10

# Force the anti-inspect guard on in `yarn dev` (it is always on in production).
# Leave unset / 0 for normal dev. Set to 1 to test right-click block, DevTools
# detection, console muting, etc. without doing a full production build.
VITE_ANTI_INSPECT=0
